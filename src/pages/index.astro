---
import BaseLayout from "../layouts/BaseLayout.astro"
import Hero from "../components/Hero.astro"
import Carousel from "../components/Carousel.astro"
---

<BaseLayout transparent>
  <Hero />
  <div class="content">
    <h2 id="inicio">Bienvenido a la sociedad científica de estudiantes de física</h2>
    <p>Lorem ipsum dolor sit amet consctetur, adipisicing elit. Error.</p>
    <p>Lorem ipsum dolor sit amet consctetur, adipisicing elit. Error.</p>
    <a href={`${import.meta.env.BASE_URL}/sobre-nosotros`}>Conocenos!</a>
  </div>
  <div class="flex justify-center">
    <Carousel />
  </div>
</BaseLayout>

<style>
  .content{
    text-align: center;
  }
  a {
    display: inline-block;
    background-color: #7a49c5;
    color: #fff;
    padding: 6px 10px;
    border-radius: 2px;
    text-decoration: none;
    margin-top: 20px;
  }
  a:hover {
    background-color: #965ee9;
  }
</style>
