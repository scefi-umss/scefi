---
import { Image } from "astro:assets"
import BaseLayout from "../layouts/BaseLayout.astro"
import Carousel from "../components/Carousel.astro"
import fotoEscuela from "../assets/fotoEscuela.jpg"
import Hero from "../components/Hero.astro"
import ProyectoCard from "../components/ProyectoCard.astro"
import ProximosEventos from "../components/ProximosEventos.astro"
import logoScefi from "../assets/nucleo/logo-scefi-grande.png"
import meteorito from "../assets/meteorito.png"

const base = import.meta.env.BASE_URL
---

<BaseLayout>
  <Hero />
  <div class="fuente-diseno overflow-x-clip bg-base-100 pb-16 text-base-content">
    <!-- 1.1 Hola, somos la SCEFI -->
    <section id="inicio" class="scroll-mt-20 px-6 pt-16 text-center">
      <div class="caja-inclinada mx-auto max-w-3xl px-8 py-10 sm:px-16" style="--giro: 7deg">
        <h2 class="text-4xl leading-tight sm:text-5xl">
          Somos la Sociedad Científica<br class="hidden sm:block" /> de Estudiantes de Física
        </h2>
        <p class="mt-4 text-justify text-2xl leading-snug sm:text-3xl">
          La SCEFI es una comunidad de estudiantes de Física que busca ir más allá del aula.
          Investigamos, creamos y compartimos ciencia, construyendo juntos nuevas formas de aprender y hacer Física.
        </p>
      </div>
      <a href={`${base}/sobre-nosotros`} class="boton mt-8">Entra en nuestro campo</a>
    </section>

    <!-- 1.2 Próximos eventos -->
    <section class="caja-inclinada mx-auto mt-16 max-w-6xl px-6 py-10 sm:px-16" style="--giro: 4deg">
      <h2 class="text-3xl uppercase sm:text-4xl">Próximos eventos</h2>
      <ProximosEventos />
    </section>

    <!-- 1.3 Proyectos destacados -->
    <section class="caja-inclinada mx-auto mt-20 max-w-6xl px-6 py-10 sm:px-16" style="--giro: -3deg">
      <h2 class="text-3xl uppercase sm:text-4xl">Proyectos destacados</h2>
      <ProyectoCard
        titulo="1RA ESCUELA DE INVIERNO"
        descripcion="Evento realizado el pasado 6 al 24 de julio del 2026, fue una actividad que se realizó con éxito para estudiantes de las carreras.."
        imagen={fotoEscuela}
        alt="Aula durante la primera escuela de invierno"
      />
      <div class="flex justify-center">
        <Carousel />
      </div>
      <div class="text-center">
        <a href={`${base}/actividades`} class="boton mt-8">Ve nuestra estela</a>
      </div>
    </section>

    <!-- 1.4 Hagamos ciencia juntos -->
    <section class="caja-inclinada mx-auto mt-20 max-w-6xl px-6 py-10 sm:px-16" style="--giro: 3deg">
      <div class="flex flex-col items-center gap-8 sm:flex-row sm:items-start">
        <Image src={logoScefi} alt="Logo de la SCEFI" class="w-40 shrink-0 sm:w-56" />
        <div>
          <h2 class="text-3xl uppercase sm:text-4xl">Hagamos ciencia juntos</h2>
          <p class="mt-6 text-2xl leading-snug sm:text-3xl">
            Hay muchas formas de participar en la SCEFI: formar parte como un miembro, colaborar,
            apoyar nuestros proyectos o compartir una idea. Encuentra tu forma de ser parte.
          </p>
          <div class="mt-8 text-center">
            <a href={`${base}/unete`} class="boton relative">
              <Image src={meteorito} alt="" class="meteorito pointer-events-none absolute -left-7 -top-7 w-14" />
              Gravita hacia nosotros
            </a>
          </div>
        </div>
      </div>
    </section>
  </div>
</BaseLayout>

<style>
  .boton {
    display: inline-block;
    border-radius: 9999px;
    background-color: var(--color-primary);
    color: #000;
    padding: 0.6rem 1.75rem;
    font-size: 1.75rem;
    text-decoration: none;
    transition: filter 0.2s;
  }
  .boton:hover {
    filter: brightness(1.08);
  }
  @media (prefers-color-scheme: dark) {
    .boton {
      color: #fff;
    }
  }
  .boton:hover .meteorito {
    transform: translate(3px, 3px);
  }
  .meteorito {
    transition: transform 0.2s;
  }
</style>
