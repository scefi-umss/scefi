---
import BaseLayout from "../layouts/BaseLayout.astro"
import Carousel from "../components/Carousel.astro"
import EventoCard from "../components/EventoCard.astro"
import eventos from "../data/eventos.json"
import fotoEscuela from "../assets/fotoEscuela.jpg"
import Hero from "../components/Hero.astro"
import ProyectoCard from "../components/ProyectoCard.astro"
---

<BaseLayout>
  <Hero />
  <div class="content">
    <h2 id="inicio" class="scroll-mt-20">Bienvenido a la sociedad científica de estudiantes de física</h2>
    <p>Lorem ipsum dolor sit amet consctetur, adipisicing elit. Error.</p>
    <p>Lorem ipsum dolor sit amet consctetur, adipisicing elit. Error.</p>
    <a href={`${import.meta.env.BASE_URL}/sobre-nosotros`}>Conocenos!</a>
    <section class="mt-16 text-left">
      <h2 class="text-3xl font-bold uppercase">Próximos eventos</h2>
     {eventos.map(evento => (
        <EventoCard
          nombre={evento.nombre}
          fecha={evento.fecha}
          color={evento.color as 'primary' | 'secondary'}
        />
      ))}
    </section>
    <section class="mt-16 text-left">
      <h2 class="text-3xl font-bold uppercase">Proyectos destacados</h2>

      <ProyectoCard
        titulo="1RA ESCUELA DE INVIERNO"
        descripcion="Evento realizado el pasado 6 al 24 de julio del 2026, fue una actividad que se realizó con éxito para estudiantes de las carreras.."
        imagen={fotoEscuela}
        alt="Aula durante la primera escuela de invierno"
      />
    </section>
  </div>
  <div class="flex justify-center">
    <Carousel />
  </div>
</BaseLayout>

<style>
  .content{
    text-align: center;
  }
  a {
    display: inline-block;
    background-color: var(--color-primary);
    color: #000;
    padding: 12px 28px;
    border-radius: 9999px;
    text-decoration: none;
    margin-top: 20px;
    font-size: 1.2em;
  }
  a:hover {
    filter: brightness(1.08);
  }
</style>
