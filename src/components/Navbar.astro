---
// Menú principal. "pista" es el texto que aparece junto al mouse al pasar sobre el enlace
// (en celular, donde no hay mouse, se muestra debajo del nombre).
const enlaces = [
  { nombre: "Inicio", ruta: "/" },
  { nombre: "Núcleo", ruta: "/sobre-nosotros", pista: "Nosotros" },
  { nombre: "Estela", ruta: "/actividades", pista: "Actividades" },
  { nombre: "¡Orbita!", ruta: "/unete", pista: "¡Únete!" },
]
---
<div class="max-lg:collapse w-full rounded-none bg-secondary shadow-sm">
  <input id="navbar-1-toggle" class="peer hidden" type="checkbox" />
  <label for="navbar-1-toggle" class="fixed inset-0 hidden max-lg:peer-checked:block"></label>
  <div class="collapse-title navbar">
    <div class="navbar-start">
      <label for="navbar-1-toggle" class="btn lg:hidden border-0 btn-secondary text-secondary-content">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h8m-8 6h16" /></svg>
      </label>
    </div>
    <div class="navbar-center hidden lg:flex">
      <ul class="menu menu-horizontal px-1">
        {enlaces.map((e) => (
          <li><a href={`${import.meta.env.BASE_URL}${e.ruta}`} data-pista={e.pista}>{e.nombre}</a></li>
        ))}
      </ul>
    </div>
    <div class="navbar-end">
      <a href={`${import.meta.env.BASE_URL}/`} class="btn border-0 text-xl btn-secondary text-secondary-content">Scefi
      </a>
    </div>
  </div>

  <div class="collapse-content lg:hidden z-1 bg-secondary">
    <ul class="menu">
      {enlaces.map((e) => (
        <li>
          <a href={`${import.meta.env.BASE_URL}${e.ruta}`} class="flex flex-col items-start gap-0">
            {e.nombre}
            {e.pista && <span class="text-xs opacity-70">{e.pista}</span>}
          </a>
        </li>
      ))}
    </ul>
  </div>
</div>

<div id="navbar-pista" class="pointer-events-none fixed z-[60] hidden rounded-full bg-primary px-3 py-1 text-sm text-black shadow-md dark:text-white" role="tooltip"></div>

<script>
  // Muestra la "pista" de cada enlace junto al mouse mientras está encima
  const pista = document.getElementById("navbar-pista")
  document.querySelectorAll<HTMLElement>("[data-pista]").forEach((enlace) => {
    enlace.addEventListener("mouseenter", () => {
      if (!pista) return
      pista.textContent = enlace.dataset.pista ?? ""
      pista.classList.remove("hidden")
    })
    enlace.addEventListener("mousemove", (ev) => {
      if (!pista) return
      pista.style.left = `${ev.clientX + 14}px`
      pista.style.top = `${ev.clientY + 18}px`
    })
    enlace.addEventListener("mouseleave", () => pista?.classList.add("hidden"))
  })
</script>
