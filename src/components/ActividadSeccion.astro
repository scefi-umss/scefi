---
import type { CollectionEntry } from 'astro:content'

interface Props {
  actividad: CollectionEntry<'actividades'>
}
const {actividad} = Astro.props
---

<div class="bg-expecard-pi py-4 px-5 my-6 mx-auto shadow-2xl dark:shadow-white/30">
  <p class="actividad-nombre">{actividad.data.name}</p>
  <p class="actividad-organizador">{actividad.data.organizer}</p>
  <a class="underline decoration-dashed decoration-2" href={`${import.meta.env.BASE_URL}/actividades/${actividad.id}`}>Enterate!</a>
</div>

<style>
  .actividad-nombre {
    font-size: 1.4em;
    font-weight: bold;
  }
  .actividad-organizador {
    margin-top: 0;
  }
</style>
