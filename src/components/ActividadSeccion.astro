---
// Tarjeta de actividad del diseño "Estela": imagen a la izquierda y texto sobre una forma inclinada
import type { CollectionEntry } from 'astro:content'
import { Image } from 'astro:assets'

interface Props {
  actividad: CollectionEntry<'actividades'>
  indice?: number   // alterna el color del botón (primary / secondary)
}
const {actividad, indice = 0} = Astro.props
const {name, organizer, image, description} = actividad.data
---

<article class="actividad relative my-8 flex flex-col gap-4 sm:flex-row sm:items-start sm:gap-8">
  {image && (
    <Image
      src={image}
      alt={name}
      class="relative z-10 aspect-[4/3] w-full shrink-0 bg-white object-cover sm:w-2/5"
    />
  )}
  <div class="relative z-10 flex-1 px-2 sm:px-0 sm:pr-4">
    <h3 class="actividad-nombre text-2xl font-normal sm:text-3xl">{name}</h3>
    <p class="actividad-organizador text-lg opacity-80">Organiza: {organizer}</p>
    {description && <p class="mt-2 text-justify text-lg leading-snug">{description}</p>}
    <div class="mt-4 flex justify-center">
      <a
        class:list={[
          "rounded-full px-10 py-2 text-lg text-black transition hover:brightness-110 dark:text-white",
          indice % 2 === 0 ? "bg-primary" : "bg-secondary",
        ]}
        href={`${import.meta.env.BASE_URL}/actividades/${actividad.id}`}
      >
        Más información
      </a>
    </div>
  </div>
</article>

<style>
  /* Forma clara (u oscura) inclinada detrás de cada actividad */
  .actividad::before {
    content: "";
    position: absolute;
    inset: -1.25rem -0.5rem -1.25rem 25%;
    z-index: 0;
    background: var(--color-base-200);
    border-radius: 3rem;
    transform: rotate(4deg);
  }
  @media (prefers-color-scheme: dark) {
    .actividad::before {
      background: var(--color-accent);
    }
  }
  @media (max-width: 639px) {
    .actividad::before {
      inset: 30% -0.5rem -1.25rem;
      transform: rotate(-3deg);
    }
  }
</style>
