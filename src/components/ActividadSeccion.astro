---
import type { CollectionEntry } from 'astro:content'

interface Props {
  actividad: CollectionEntry<'actividades'>
}
const {actividad} = Astro.props
---

<div class="actividad-seccion">
  <p class="actividad-nombre">{actividad.data.name}</p>
  <p class="actividad-organizador">{actividad.data.organizer}</p>
  <a href={`/actividades/${actividad.id}`}>Enterate!</a>
</div>

<style>
  h2 {
    padding-right: 10px;
    border-right: 8px solid #ebe5f2;
    border-bottom: 8px solid #f9f6fc;
    margin-bottom: 40px;
    text-align: right;
  }
  .actividad-seccion {
    background-color: #f9f6fc;
    padding: 16px 20px;
    margin: 20px auto;
    box-shadow: 8px 8px 0 #ebe5f2;
  }
  .actividad-nombre {
    font-size: 1.4em;
    font-weight: bold;
    margin: 0;
  }
  .actividad-organizador {
    margin-top: 0;
  }
</style>
