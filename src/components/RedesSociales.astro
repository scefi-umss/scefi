---
// Íconos de redes sociales del pie de página
interface Props {
  class?: string
}
const { class: clase } = Astro.props

// TODO: reemplazar "#" por los enlaces reales de cada red
const redes = [
  { nombre: "Instagram", href: "#", icono: "instagram" },
  { nombre: "TikTok", href: "#", icono: "tiktok" },
  { nombre: "LinkedIn", href: "#", icono: "linkedin" },
  { nombre: "Correo", href: "#", icono: "correo" },
  { nombre: "YouTube", href: "#", icono: "youtube" },
]
---
<ul class:list={["flex flex-wrap items-center gap-2 sm:gap-4", clase]}>
  {redes.map((red) => (
    <li>
      <a href={red.href} aria-label={red.nombre} class="block text-black transition hover:opacity-70">
        {red.icono === "instagram" && (
          <svg class="h-8 w-8 sm:h-10 sm:w-10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><rect x="2.5" y="2.5" width="19" height="19" rx="5.5" /><circle cx="12" cy="12" r="4.3" /><circle cx="17.6" cy="6.4" r="1.1" fill="currentColor" stroke="none" /></svg>
        )}
        {red.icono === "tiktok" && (
          <svg class="h-8 w-8 sm:h-10 sm:w-10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"><path d="M13 3h3a4.5 4.5 0 0 0 4 4v3a7.5 7.5 0 0 1-4-1.3V15a6 6 0 1 1-6-6v3.2A2.8 2.8 0 1 0 13 15V3z" /></svg>
        )}
        {red.icono === "linkedin" && (
          <svg class="h-8 w-8 sm:h-10 sm:w-10" viewBox="0 0 24 24" fill="currentColor"><path d="M20.45 20.45h-3.56v-5.57c0-1.33-.02-3.04-1.85-3.04-1.850 0-2.14 1.45-2.14 2.94v5.67H9.35V9h3.41v1.56h.05c.48-.9 1.64-1.85 3.37-1.85 3.6 0 4.27 2.37 4.27 5.46v6.28zM5.34 7.43a2.06 2.06 0 1 1 0-4.13 2.06 2.06 0 0 1 0 4.13zM7.12 20.45H3.56V9h3.56v11.45zM22.22 0H1.77C.79 0 0 .77 0 1.73v20.54C0 23.23.79 24 1.77 24h20.45c.98 0 1.78-.77 1.78-1.73V1.73C24 .77 23.2 0 22.22 0z" /></svg>
        )}
        {red.icono === "correo" && (
          <svg class="h-8 w-8 sm:h-10 sm:w-10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"><path d="M2.5 9.5 12 3l9.5 6.5V21h-19V9.5z" /><path d="m2.5 9.5 9.5 7 9.5-7" /><path d="m2.5 21 7-6M21.5 21l-7-6" /><circle cx="12" cy="9.5" r="2" /><path d="M14 9.5v.8a1.2 1.2 0 0 0 2.4 0v-.8a4.4 4.4 0 1 0-1.8 3.6" /></svg>
        )}
        {red.icono === "youtube" && (
          <svg class="h-8 w-10 sm:h-10 sm:w-12" viewBox="0 0 28 20" fill="currentColor"><path d="M27.4 3.1A3.5 3.5 0 0 0 25 .6C22.8 0 14 0 14 0S5.2 0 3 .6A3.5 3.5 0 0 0 .6 3.1C0 5.3 0 10 0 10s0 4.7.6 6.9A3.5 3.5 0 0 0 3 19.4c2.2.6 11 .6 11 .6s8.8 0 11-.6a3.5 3.5 0 0 0 2.4-2.5c.6-2.2.6-6.9.6-6.9s0-4.7-.6-6.9zM11.2 14.3V5.7L18.5 10l-7.3 4.3z" /></svg>
        )}
      </a>
    </li>
  ))}
</ul>
