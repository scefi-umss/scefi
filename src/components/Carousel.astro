---
// Carrusel de actividades destacadas. Recibe la lista desde la página
// (colección `actividades` ordenada): nada hardcodeado aquí.
import type { CollectionEntry } from "astro:content"
import ProyectoCard from "./ProyectoCard.astro"
import { base } from "../lib/url"

interface Props {
  actividades: CollectionEntry<"actividades">[]
}
const { actividades } = Astro.props
---
<div class="carousel carousel-center bg-neutral rounded-box max-w-4xl space-x-4 p-4">
  {actividades.map((actividad) => (
    <div class="carousel-item w-90">
      <ProyectoCard
        titulo={actividad.data.name}
        descripcion={actividad.data.description ?? ""}
        imagen={actividad.data.image}
        alt={actividad.data.name}
        href={base(`/actividades/${actividad.id}`)}
      />
    </div>
  ))}
</div>
